+                            equalTo(MESSAGING_OPERATION_NAME, "send"),
+                            equalTo(MESSAGING_OPERATION_TYPE, "send"),
+                            equalTo(MESSAGING_KAFKA_MESSAGE_KEY, "test-key"),
+                            equalTo(MESSAGING_DESTINATION_PARTITION_ID, "3"),
