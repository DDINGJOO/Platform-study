+
+  // Since the Kafka client fills in a RecordMetadata with partition -1 (no partition assigned yet)
+  // and offset -1 when a send fails, these are "unknown" markers and must not become attributes.
+  @Test
+  @SuppressWarnings("unchecked")
+  void producerSpanHasNoPartitionAndOffsetWhenSendFailsBeforePartitionAssigned() {
+    Producer<String, String> producer = mock(Producer.class);
+    doAnswer(
+            invocation -> {
+              Callback callback = invocation.getArgument(1);
+              callback.onCompletion(
+                  new RecordMetadata(
+                      new TopicPartition("test-topic", RecordMetadata.UNKNOWN_PARTITION),
+                      -1,
+                      -1,
+                      RecordBatch.NO_TIMESTAMP,
+                      -1L,
+                      -1,
+                      -1),
+                  new KafkaException("send failed"));
+              return null;
+            })
+        .when(producer)
+        .send(any(), any());
+
+    KafkaTelemetry telemetry = KafkaTelemetry.builder(testing.getOpenTelemetry()).build();
+    Producer<String, String> wrappedProducer = telemetry.wrap(producer);
+
+    ProducerRecord<String, String> record =
+        new ProducerRecord<>("test-topic", "test-key", "test-value");
+    testing.runWithSpan("parent", () -> wrappedProducer.send(record));
+
+    testing.waitAndAssertTraces(
+        trace ->
+            trace.hasSpansSatisfyingExactly(
+                span -> span.hasName("parent").hasKind(SpanKind.INTERNAL).hasNoParent(),
+                span ->
+                    span.hasName("send test-topic")
+                        .hasKind(SpanKind.PRODUCER)
+                        .hasParent(trace.getSpan(0))
+                        .hasStatus(StatusData.error())
+                        .hasAttributesSatisfyingExactly(
+                            equalTo(MESSAGING_SYSTEM, "kafka"),
+                            equalTo(MESSAGING_DESTINATION_NAME, "test-topic"),
+                            equalTo(MESSAGING_OPERATION_NAME, "send"),
+                            equalTo(MESSAGING_OPERATION_TYPE, "send"),
+                            equalTo(MESSAGING_KAFKA_MESSAGE_KEY, "test-key"),
+                            equalTo(ERROR_TYPE, KafkaException.class.getName()))));
+  }
+
+  // Kafka reports the real partition but offset -1 when the send fails after partition assignment.
+  @Test
+  @SuppressWarnings("unchecked")
+  void producerSpanKeepsPartitionButNotOffsetWhenSendFailsAfterPartitionAssigned() {
+    Producer<String, String> producer = mock(Producer.class);
+    KafkaException failure = new KafkaException("send failed");
+    doAnswer(
+            invocation -> {
+              Callback callback = invocation.getArgument(1);
+              callback.onCompletion(
+                  new RecordMetadata(
+                      new TopicPartition("test-topic", 3),
+                      -1,
+                      -1,
+                      RecordBatch.NO_TIMESTAMP,
+                      -1L,
+                      -1,
+                      -1),
+                  failure);
+              return null;
+            })
+        .when(producer)
+        .send(any(), any());
+
+    KafkaTelemetry telemetry = KafkaTelemetry.builder(testing.getOpenTelemetry()).build();
+    Producer<String, String> wrappedProducer = telemetry.wrap(producer);
+
+    ProducerRecord<String, String> record =
+        new ProducerRecord<>("test-topic", "test-key", "test-value");
+    testing.runWithSpan("parent", () -> wrappedProducer.send(record));
+
+    testing.waitAndAssertTraces(
+        trace ->
+            trace.hasSpansSatisfyingExactly(
+                span -> span.hasName("parent").hasKind(SpanKind.INTERNAL).hasNoParent(),
+                span ->
+                    span.hasName("send test-topic")
+                        .hasKind(SpanKind.PRODUCER)
+                        .hasParent(trace.getSpan(0))
+                        .hasStatus(StatusData.error())
+                        .hasAttributesSatisfyingExactly(
+                            equalTo(MESSAGING_SYSTEM, "kafka"),
