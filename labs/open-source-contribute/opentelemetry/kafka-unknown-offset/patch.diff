+      // when a send fails, kafka-clients passes a RecordMetadata where the partition (if it was not
+      // assigned yet) and the offset are -1, which means "unknown" and should not be recorded
+      if (recordMetadata.partition() >= 0) {
+        attributes.put(
+            MESSAGING_DESTINATION_PARTITION_ID, String.valueOf(recordMetadata.partition()));
+      }
+      if (recordMetadata.offset() >= 0) {
+        attributes.put(MESSAGING_KAFKA_OFFSET, recordMetadata.offset());
+      }
