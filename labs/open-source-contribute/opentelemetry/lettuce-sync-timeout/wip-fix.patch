+  @Test
+  void testCommandTimeout() {
+    StatefulRedisConnection<String, String> timeoutConnection = redisClient.connect();
+    cleanup.deferCleanup(timeoutConnection);
+    if (connectionTelemetryEnabled()) {
+      testing.waitForTraces(1);
+    }
+    testing.clearData();
+    timeoutConnection.setTimeout(Duration.ofMillis(300));
+
+    // the sync API cancels the command when the timeout expires and throws the timeout exception
+    // to the caller only, the command future itself completes with a CancellationException
+    Exception exception =
+        catchException(() -> timeoutConnection.sync().blpop(2, "TIMEOUT_LIST"));
+
+    assertThat(exception).isInstanceOf(RedisCommandTimeoutException.class);
+    testing.waitAndAssertTraces(
+        trace ->
+            trace.hasSpansSatisfyingExactly(
+                span ->
+                    span.hasName("BLPOP " + host + ":" + port)
+                        .hasKind(SpanKind.CLIENT)
+                        .hasStatus(StatusData.error())
+                        .hasException(exception)
+                        .hasAttributesSatisfyingExactly(
+                            equalTo(SERVER_ADDRESS, host),
+                            equalTo(SERVER_PORT, port),
+                            equalTo(DB_SYSTEM_NAME, REDIS),
+                            equalTo(DB_NAMESPACE, "0"),
+                            equalTo(DB_QUERY_TEXT, "BLPOP TIMEOUT_LIST 2"),
+                            equalTo(DB_OPERATION_NAME, "BLPOP"),
+                            equalTo(ERROR_TYPE, "io.lettuce.core.RedisCommandTimeoutException"),
+                            equalTo(booleanKey("lettuce.command.cancelled"), experimental(true)))));
+  }
 }
