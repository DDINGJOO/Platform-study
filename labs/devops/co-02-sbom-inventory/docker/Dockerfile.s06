# s06 만 다르다. 운영 쪽에서 jar 두 개를 이미지에 더 넣고 PropertiesLauncher 의 loader.path 로 읽힌다.
# 빌드 때 만든 SBOM 은 이 jar 들을 모른다.
FROM eclipse-temurin:21-jre
ARG SERVICE
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION \
      lab.co02.service=$SERVICE
COPY $SERVICE.jar /app/app.jar
COPY extra/ /app/extra/
ENTRYPOINT ["java", "-cp", "/app/app.jar", "-Dloader.path=/app/extra", "org.springframework.boot.loader.launch.PropertiesLauncher"]
