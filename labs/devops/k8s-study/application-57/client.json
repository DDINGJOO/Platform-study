{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "request-client",
    "namespace": "app-capstone"
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "k8s-worker2"
    },
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "client",
        "image": "busybox:1.36.1",
        "command": [
          "sh",
          "-c",
          "sleep 600"
        ]
      }
    ]
  }
}