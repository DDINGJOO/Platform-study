{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "calico-blog-52"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "client",
        "namespace": "calico-blog-52",
        "labels": {
          "experiment": "calico52"
        }
      },
      "spec": {
        "nodeName": "k8s-worker1",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.11.1",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            },
            "command": [
              "sleep",
              "3600"
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "local",
        "namespace": "calico-blog-52",
        "labels": {
          "experiment": "calico52"
        }
      },
      "spec": {
        "nodeName": "k8s-worker1",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "local",
            "image": "nginx:1.25.1-alpine",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "remote",
        "namespace": "calico-blog-52",
        "labels": {
          "experiment": "calico52"
        }
      },
      "spec": {
        "nodeName": "k8s-worker2",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "remote",
            "image": "nginx:1.25.1-alpine",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    }
  ]
}
