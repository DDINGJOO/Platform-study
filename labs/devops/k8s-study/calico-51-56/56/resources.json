{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "client",
        "namespace": "calico-blog-56",
        "labels": {
          "app": "client"
        }
      },
      "spec": {
        "nodeName": "k8s-worker1",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.11.1",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "1m",
                "memory": "12Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "command": [
              "sh",
              "-c",
              "sleep 3600"
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "local",
        "namespace": "calico-blog-56",
        "labels": {
          "app": "local"
        }
      },
      "spec": {
        "nodeName": "k8s-worker1",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "local",
            "image": "nginx:1.25.1-alpine",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "1m",
                "memory": "12Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 80
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 1
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "remote",
        "namespace": "calico-blog-56",
        "labels": {
          "app": "web"
        }
      },
      "spec": {
        "nodeName": "k8s-worker2",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "remote",
            "image": "nginx:1.25.1-alpine",
            "imagePullPolicy": "Never",
            "resources": {
              "requests": {
                "cpu": "1m",
                "memory": "12Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 80
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 1
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "web",
        "namespace": "calico-blog-56"
      },
      "spec": {
        "selector": {
          "app": "web"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": 80
          }
        ]
      }
    }
  ]
}
