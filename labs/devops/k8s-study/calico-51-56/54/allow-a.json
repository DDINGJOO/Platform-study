{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "allow-a",
    "namespace": "calico-blog-54"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "role": "server"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "role": "a"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 80
          }
        ]
      }
    ]
  }
}
