<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>lab.co4</groupId>
  <artifactId>app</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.15</jacoco.version>
  </properties>

  <profiles>
    <!-- 기본으로 켜진다. -Dnotypes 를 주면 로깅 라이브러리가 클래스패스에서 빠진다(타입 없는 파싱 실험) -->
    <profile>
      <id>logging</id>
      <activation><property><name>!notypes</name></property></activation>
      <dependencies>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.20</version></dependency>
        <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><version>1.6.5</version></dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <!-- target/lib 에 런타임 의존성, target/jacoco 에 에이전트와 CLI 를 복사한다 -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration><outputDirectory>${project.build.directory}/lib</outputDirectory><includeScope>runtime</includeScope></configuration>
          </execution>
          <execution>
            <id>jacoco</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/jacoco</outputDirectory>
              <stripVersion>true</stripVersion>
              <artifactItems>
                <artifactItem><groupId>org.jacoco</groupId><artifactId>org.jacoco.agent</artifactId><version>${jacoco.version}</version><classifier>runtime</classifier></artifactItem>
                <artifactItem><groupId>org.jacoco</groupId><artifactId>org.jacoco.cli</artifactId><version>${jacoco.version}</version><classifier>nodeps</classifier></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Maven Central 에 있는 마지막 판. 이후 판은 인증이 필요한 별도 저장소로만 배포된다(README 참고) -->
        <groupId>org.openrewrite.maven</groupId>
        <artifactId>rewrite-maven-plugin</artifactId>
        <version>6.46.1</version>
      </plugin>
    </plugins>
  </build>
</project>
