{
 "uid": "gameday",
 "title": "주문 게임데이",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "gameday events",
    "enable": true,
    "iconColor": "#b3502f",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "gameday"
     ],
     "limit": 100,
     "matchAny": true
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "주문 실패율 (1분 창)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "order:error_ratio:rate1m",
     "legendFormat": "실패율",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p99 지연: 주문 서버 / 주문이 본 재고 호출 / 재고 서버 자체",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_seconds_bucket{service=\"order\"}[1m])))",
     "legendFormat": "order 서버",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(upstream_duration_seconds_bucket{service=\"order\"}[1m])))",
     "legendFormat": "order→inventory 호출",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_seconds_bucket{service=\"inventory\"}[1m])))",
     "legendFormat": "inventory 서버",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "state-timeline",
   "title": "경고 상태와 완화 스위치",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "정상",
         "color": "#e8eef3",
         "index": 0
        },
        "1": {
         "text": "pending",
         "color": "#e5a33c",
         "index": 1
        },
        "2": {
         "text": "firing",
         "color": "#e5533c",
         "index": 2
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#e8eef3",
        "value": null
       },
       {
        "color": "#e5a33c",
        "value": 1
       },
       {
        "color": "#e5533c",
        "value": 2
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fallback"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "꺼짐",
            "color": "#e8eef3",
            "index": 0
           },
           "1": {
            "text": "켜짐",
            "color": "#4a7fb5",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#e8eef3",
           "value": null
          },
          {
           "color": "#4a7fb5",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(max(ALERTS{alertname=\"OrderErrorRatioHigh\",alertstate=\"firing\"}) * 2) or max(ALERTS{alertname=\"OrderErrorRatioHigh\",alertstate=\"pending\"}) or vector(0)",
     "legendFormat": "OrderErrorRatioHigh (page)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "(max(ALERTS{alertname=\"OrderLatencyHigh\",alertstate=\"firing\"}) * 2) or max(ALERTS{alertname=\"OrderLatencyHigh\",alertstate=\"pending\"}) or vector(0)",
     "legendFormat": "OrderLatencyHigh (ticket)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "max(order_fallback_enabled{job=\"order\"})",
     "legendFormat": "fallback",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ]
}