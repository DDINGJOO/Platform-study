<settings>
  <!-- Maven 3.8.1 부터 http 저장소는 maven-default-http-blocker 미러가 막는다. 실습 저장소는 http 라서 그 차단을 끈다 -->
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:dummy:*</mirrorOf>
      <url>http://0.0.0.0/</url>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
  <!-- Maven Central 대신 실습 저장소만 본다. updatePolicy 는 일부러 적지 않는다(기본값 daily 를 보려는 것) -->
  <profiles>
    <profile>
      <id>lab</id>
      <repositories>
        <repository>
          <id>lab-releases</id>
          <url>http://reposilite:8080/releases</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>lab-snapshots</id>
          <url>http://reposilite:8080/snapshots</url>
          <releases><enabled>false</enabled></releases>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>lab</activeProfile></activeProfiles>
</settings>
