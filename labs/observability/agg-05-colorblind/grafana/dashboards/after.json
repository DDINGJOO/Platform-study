  {
   "id": 3,
   "type": "stat",
   "title": "SLO 상태 (에러 비율 1% 미만)",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\",outcome=\"SERVER_ERROR\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m]))",
     "legendFormat": "{{uri}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "#56B4E9"
       },
       {
        "value": 0.01,
        "color": "#D55E00"
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": 0,
        "to": 0.0099999,
        "result": {
         "text": "✓ 정상"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 0.01,
        "to": 1,
        "result": {
         "text": "✕ 초과"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
