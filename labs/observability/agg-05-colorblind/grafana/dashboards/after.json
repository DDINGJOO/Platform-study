{
 "uid": "cvd-after",
 "title": "실습-5 고친 대시보드",
 "schemaVersion": 41,
 "editable": true,
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "엔드포인트별 에러 비율 (점선 영역 = SLO 1% 초과)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\",outcome=\"SERVER_ERROR\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m]))",
     "legendFormat": "{{uri}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "thresholdsStyle": {
       "mode": "dashed+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "transparent"
       },
       {
        "value": 0.01,
        "color": "#D55E00"
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "/api/checkout"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#0072B2"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "solid"
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 3
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "/api/order"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E69F00"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "/api/search"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#009E73"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dot",
         "dash": [
          0,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "/api/cart"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#CC79A7"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          20,
          6,
          4,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "/api/login"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#56B4E9"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          4,
          4
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
