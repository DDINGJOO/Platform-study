          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{uri=\"/orders\",outcome=\"SERVER_ERROR\"}[20s])) / sum by (instance) (rate(http_server_requests_seconds_count{uri=\"/orders\"}[20s]))",
