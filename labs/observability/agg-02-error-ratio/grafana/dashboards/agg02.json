          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/orders\",outcome=\"SERVER_ERROR\"}[20s])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri=\"/orders\"}[20s]))",
          "legendFormat": "B. 분자에 or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/orders\",outcome=\"SERVER_ERROR\"}[20s])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{uri=\"/orders\"}[20s])) > 0)",
          "legendFormat": "C. B + 분모 > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/orders\",outcome=\"SERVER_ERROR\"}[20s])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{uri=\"/orders\"}[20s])) >= 1)",
          "legendFormat": "D. B + 분모 ≥ 1 req/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
