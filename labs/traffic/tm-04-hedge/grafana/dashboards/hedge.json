{
 "uid": "tm04",
 "title": "실습-4 헤지 요청",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "사용자가 본 지연 (Envoy 리스너 기준, 30초 창)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=\"ingress\"}[30s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=\"ingress\"}[30s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.999, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=\"ingress\"}[30s])))",
     "legendFormat": "p99.9",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "초당 추가로 보낸 요청과, 응답을 기다리다 끊은 백엔드 연결",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_retry{envoy_cluster_name=~\"backend_(hedge|retry)\"}[30s]))",
     "legendFormat": "사본·재시도 {{envoy_cluster_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_cx_destroy_local_with_active_rq{envoy_cluster_name=~\"backend_(hedge|retry)\"}[30s]))",
     "legendFormat": "응답 전에 끊은 연결 {{envoy_cluster_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "초당 요청: 사용자가 보낸 것과 백엔드가 받은 것",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(envoy_http_downstream_rq_total{envoy_http_conn_manager_prefix=\"ingress\"}[30s]))",
     "legendFormat": "사용자 요청 (Envoy 리스너)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(lab_work_received_total[30s]))",
     "legendFormat": "백엔드 세 대가 받은 요청",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ]
}