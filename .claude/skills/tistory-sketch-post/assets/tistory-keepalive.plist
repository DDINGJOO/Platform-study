<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 티스토리 세션(TSSESSION)은 30~40분 쓰지 않으면 끊긴다. 15분마다 관리 페이지를 열어 살려 둔다 -->
  <key>Label</key><string>com.dding.tistory-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dding/.local/share/tistory-uploader/venv/bin/python</string>
    <string>/Users/dding/orca/Platform-study/.claude/skills/tistory-sketch-post/assets/tistory-upload.py</string>
    <string>keepalive</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/dding/.local/share/tistory-uploader/keepalive.log</string>
  <key>StandardErrorPath</key><string>/Users/dding/.local/share/tistory-uploader/keepalive.log</string>
</dict>
</plist>
